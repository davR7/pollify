generator client {
  provider     = "prisma-client"
  output       = "../src/infra/database/prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  fullname  String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  polls     Poll[]
  votes     Vote[]
  createdAt DateTime
  updatedAt DateTime @updatedAt()

  @@map("users")
}

model Poll {
  id        String       @id
  title     String
  options   PollOption[]
  status    PollStatus   @default(DRAFT)
  startsAt  DateTime
  endsAt    DateTime
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  votes     Vote[]
  createdAt DateTime
  updatedAt DateTime     @updatedAt()

  @@map("polls")
}

model PollOption {
  id        String   @id
  text      String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId    String
  votes     Vote[]
  createdAt DateTime

  @@map("poll_options")
}

model Vote {
  id        String     @id
  user      User       @relation(fields: [userId], references: [id])
  userId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId    String
  option    PollOption @relation(fields: [optionId], references: [id])
  optionId  String
  createdAt DateTime

  @@unique([pollId, userId])
  @@map("votes")
}

enum UserRole {
  USER
  ADMIN
}

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
}
